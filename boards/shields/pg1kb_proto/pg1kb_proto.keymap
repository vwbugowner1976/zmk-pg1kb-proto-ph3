#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <behaviors/jpkeysforuslayout.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        lt {
            tapping-term-ms = <150>;
            quick-tap-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /*
         * layers はコンボ発火時の「最上位のアクティブレイヤー」と比較される。
         * <0> は他のレイヤーを保持していない状態、つまり Base のみを意味する。
         */
        combo-bs {
            bindings = <&kp BACKSPACE>;
            key-positions = <27 28>;
            layers = <0>;
        };

        combo-del {
            bindings = <&kp DELETE>;
            key-positions = <28 29>;
            layers = <0>;
        };

        combo-enter {
            bindings = <&kp ENTER>;
            key-positions = <27 28 29>;
            layers = <0>;
        };

        combo-bs-left {
            bindings = <&kp BACKSPACE>;
            key-positions = <22 23>;
            layers = <0>;
        };

        combo-del-left {
            bindings = <&kp DELETE>;
            key-positions = <23 24>;
            layers = <0>;
        };

        combo-enter-left {
            bindings = <&kp ENTER>;
            key-positions = <22 23 24>;
            layers = <0>;
        };

        /* Num レイヤーのコピー + ペースト同時押しでカット */
        combo-cut {
            bindings = <&kp LC(X)>;
            key-positions = <4 5>;
            layers = <1>;
        };

        /* 左クリック + 右クリック同時押しでミドルクリック */
        combo-mclk {
            bindings = <&mkp MCLK>;
            key-positions = <2 3>;
            layers = <0>;
        };

        /* 左手最下段の LEFT_ALT + LEFT_GUI 同時押しで Sys レイヤー（押している間だけ） */
        combo-sys {
            bindings = <&mo 3>;
            key-positions = <44 45>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC         &mkp MB4                              &mkp LCLK  &mkp RCLK      &mkp MCLK         &mkp LCLK                         &mkp MB5   &jp_minusunder
&kp TAB         &kp Q     &kp W         &kp E         &kp R      &kp T          &kp Y             &kp U      &kp I      &kp O       &kp P      &jp_equalplus
&kp LCTRL       &kp A     &kp S         &kp D         &kp F      &kp G          &kp H             &kp J      &kp K      &kp L       &jp_semicoloncolon  &jp_quotedquote
&kp LEFT_SHIFT  &kp Z     &kp X         &kp C         &kp V      &kp B          &kp N             &kp M      &kp COMMA  &kp PERIOD  &kp SLASH  &jp_yenpipe
                          &kp LEFT_ALT  &kp LEFT_GUI  &kp SPACE  &lt 1 LANG2    &lt 2 LANGUAGE_1  &kp ENTER  &kp RCTRL  &kp RSHIFT
            >;
        };

        layer_1 {
            display-name = "Num";
            bindings = <
&trans  &kp N0                  &trans  &trans    &kp LC(C)  &kp LC(V)                     &trans   &kp BSPC
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6     &kp N7     &kp N8  &kp N9     &kp N0   &kp DEL
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT   &kp DOWN   &kp UP  &kp RIGHT  &trans   &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6     &kp F7     &kp F8  &kp F9     &kp F10  &kp F11
                &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans
            >;
        };

        layer_2 {
            display-name = "Sym";
            bindings = <
&jp_baqt   &kp EXCL                           &trans       &trans       &trans       &trans                                     &kp END          &kp F12
&jp_tilde  &kp QUESTION  &jp_at     &kp HASH  &kp DOLLAR   &kp PERCENT  &jp_caret    &jp_amp            &jp_aster    &kp HOME  &kp PRINTSCREEN  &trans
&trans     &trans        &trans     &trans    &jp_lbrkt   &jp_lbrace   &jp_rbrace   &jp_rbrkt          &trans       &trans    &jp_colon        &jp_dquote
&trans     &trans        &trans     &trans    &jp_lpar    &kp LESS_THAN &kp GREATER_THAN &jp_rpar       &trans       &trans    &kp QUESTION     &jp_pipe
                         &trans     &trans    &trans       &trans       &trans       &trans              &trans       &trans
            >;
        };

        layer_3 {
            display-name = "Sys";
            bindings = <
&studio_unlock  &sys_reset                                &bt BT_CLR    &bt BT_CLR_ALL    &trans  &trans                            &trans           &trans
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &trans  &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp KP_MULTIPLY  &kp KP_DIVIDE
&trans          &trans        &trans        &trans        &trans        &trans            &trans  &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp KP_PLUS      &kp KP_MINUS
&trans          &trans        &trans        &trans        &trans        &trans            &trans  &kp KP_N1  &kp KP_N2  &kp KP_N3   &kp KP_EQUAL     &trans
                              &trans        &trans        &trans        &trans            &trans  &kp KP_N0  &trans     &kp KP_DOT
            >;
        };

        /*
         * ZMK Studio でのみ使える予備レイヤー。
         * status = "reserved" のレイヤーは通常ビルドでは無視され、
         * Studio 有効ビルドでのみ「追加できるレイヤー」として現れる。
         */
        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };
    };
};

/*
 * トラックボールの役割：
 *
 *            左ボール                   右ボール
 *   Base     スクロール     1/2          カーソル      3/2
 *   Num      カーソル       3/2          精密カーソル  1/2
 *   Sym      精密スクロール 1/6          スクロール    1/2
 *
 * lrot / rrot は左右それぞれの共通任意角度補正。My Keeb Studioから変更する。
 * 0° は現在の実機確認済み挙動をそのまま保つ相対補正値。
 * その後段で既存の固定向き補正を行い、速度倍率とXY→scroll変換を
 * lscroll/lmove/lprec/rmove/rprec/rscroll が担当する。
 * スクロール慣性は runtime input processor の後段に置く。
 */
&left_trackball_listener {
    input-processors =
        <&rip_lrot>,
        <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,
        <&rip_lscr>,
        <&scroll_inertia_left_base>;

    move_on_num {
        layers = <1>;
        input-processors =
            <&rip_lrot>,
            <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT)>,
            <&rip_lmov>;
    };

    precise_scroll_on_sym {
        layers = <2>;
        input-processors =
            <&rip_lrot>,
            <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,
            <&rip_lpre>,
            <&scroll_inertia_left_sym>;
    };
};

&right_trackball_listener {
    input-processors =
        <&rip_rrot>,
        <&zip_xy_transform 0>,
        <&rip_rmov>;

    precise_move_on_num {
        layers = <1>;
        input-processors =
            <&rip_rrot>,
            <&zip_xy_transform 0>,
            <&rip_rpre>;
    };

    scroll_on_sym {
        layers = <2>;
        input-processors =
            <&rip_rrot>,
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&rip_rscr>,
            <&scroll_inertia_right_sym>;
    };
};